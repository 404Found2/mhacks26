# Key from https://openrouter.ai/keys
# openrouter_key is also accepted if that name is already in .env
OPENROUTER_API_KEY=

# Free router: https://openrouter.ai/openrouter/free
OPENROUTER_MODEL=openrouter/free

# Sent as OpenRouter's HTTP-Referer attribution header
OPENROUTER_SITE_URL=http://localhost:5173
